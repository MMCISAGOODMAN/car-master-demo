.search-input-wrap {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 8rpx 8rpx 8rpx 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 64rpx;
}

.search-btn {
  background: #e94560;
  color: #fff;
  font-size: 26rpx;
  padding: 16rpx 32rpx;
  border-radius: 32rpx;
}

.result-count {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.part-item {
  display: flex;
  padding: 0;
  overflow: hidden;
}

.part-image {
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
  background: #f0f0f0;
}

.part-info {
  flex: 1;
  padding: 20rpx 24rpx;
}

.part-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.part-category {
  font-size: 22rpx;
  color: #e94560;
  margin: 4rpx 0 8rpx;
}

.part-desc {
  font-size: 24rpx;
  color: #888;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
