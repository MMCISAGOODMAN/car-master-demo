.detail-image {
  width: 100%;
  height: 400rpx;
  border-radius: 16rpx;
  background: #f0f0f0;
  margin-bottom: 24rpx;
}

.detail-header {
  margin-bottom: 24rpx;
}

.header-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.fav-btn {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #888;
  padding: 10rpx 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 999rpx;
  white-space: nowrap;
}

.fav-btn.active {
  color: #e94560;
  border-color: rgba(233, 69, 96, 0.4);
  background: rgba(233, 69, 96, 0.08);
}

.detail-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 8rpx;
}

.detail-category {
  display: inline-block;
  font-size: 22rpx;
  color: #e94560;
  background: rgba(233, 69, 96, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.section-content {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
}

.fault-text {
  color: #e94560;
}

.related-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.related-item:last-child { border-bottom: none; }
.related-title { font-size: 28rpx; color: #1a1a2e; font-weight: 500; }
.related-meta { font-size: 24rpx; color: #999; margin-top: 6rpx; }
