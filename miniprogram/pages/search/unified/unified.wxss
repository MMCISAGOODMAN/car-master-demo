.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 48rpx;
  background: #f7f8fa;
  box-sizing: border-box;
}

.search-box {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.search-input {
  flex: 1;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  border: 1rpx solid #eef0f3;
}

.search-btn {
  background: #e94560;
  color: #fff;
  padding: 0 28rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  font-size: 28rpx;
}

.tabs {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #eef0f3;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 14rpx;
  font-size: 26rpx;
  color: #888;
  border-radius: 8rpx;
}

.tab.active {
  background: #e94560;
  color: #fff;
  font-weight: 600;
}

.hot-title {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 16rpx;
}

.hot-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.hot-tag {
  background: #fff;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #555;
  border: 1rpx solid #eef0f3;
}

.section-label {
  font-size: 24rpx;
  color: #999;
  margin: 16rpx 0 12rpx;
}

.result-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #eef0f3;
}

.result-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
  margin-right: 20rpx;
}

.result-info { flex: 1; min-width: 0; }
.result-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
}
.result-meta {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}
