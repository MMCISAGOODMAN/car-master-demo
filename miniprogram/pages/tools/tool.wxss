@import '../../app.wxss';

.tool-page {
  min-height: 100vh;
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
  background: #f7f8fa;
}

.tool-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #eef0f3;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.tool-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 16rpx;
}

.tool-input {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.tool-btn {
  background: linear-gradient(135deg, #e94560, #d63850);
  color: #fff;
  text-align: center;
  padding: 22rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.tool-btn.secondary {
  background: #f0f0f0;
  color: #555;
}

.tool-btn.blue {
  background: linear-gradient(135deg, #0f3460, #1a4a7a);
}

.tool-tip {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}

.tool-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 26rpx;
}

.tool-row:last-child {
  border-bottom: none;
}

.tool-label {
  color: #888;
}

.tool-value {
  color: #333;
  font-weight: 500;
  text-align: right;
  flex: 1;
  margin-left: 24rpx;
}

.tool-empty {
  text-align: center;
  color: #999;
  padding: 60rpx 0;
  font-size: 28rpx;
}

.list-item-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #eef0f3;
}

.list-item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 8rpx;
}

.list-item-meta {
  font-size: 24rpx;
  color: #999;
}

.list-item-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
  gap: 16rpx;
}

.action-btn {
  font-size: 24rpx;
  color: #e94560;
  padding: 8rpx 20rpx;
  border: 1rpx solid rgba(233, 69, 96, 0.3);
  border-radius: 8rpx;
}

.action-btn.danger {
  color: #999;
  border-color: #ddd;
}
