@import '../tool.wxss';

.tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #eef0f3;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  font-size: 28rpx;
  color: #888;
  border-radius: 12rpx;
}
.tab.active {
  background: #e94560;
  color: #fff;
  font-weight: 600;
}

.fav-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #eef0f3;
}
.fav-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.fav-info { flex: 1; min-width: 0; }
.fav-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.fav-meta { font-size: 24rpx; color: #999; margin-top: 6rpx; }
