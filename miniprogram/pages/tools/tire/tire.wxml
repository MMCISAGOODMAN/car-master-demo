<view class="tool-page">
  <view class="tool-card">
    <view class="tool-card-title">选择车型</view>
    <picker range="{{types}}" range-key="name" value="{{index}}" bindchange="onPick">
      <view class="tool-input picker">{{types[index].name}}</view>
    </picker>
  </view>
  <view class="tool-card">
    <view class="tool-card-title">推荐胎压 (kPa)</view>
    <view class="tool-row"><text class="tool-label">前轮</text><text class="tool-value">{{types[index].front}} kPa</text></view>
    <view class="tool-row"><text class="tool-label">后轮</text><text class="tool-value">{{types[index].rear}} kPa</text></view>
    <view class="tool-row"><text class="tool-label">满载</text><text class="tool-value">{{types[index].full}} kPa</text></view>
    <view class="tool-tip" style="margin-top:16rpx">冷胎测量，仅供参考，请以车门铭牌为准</view>
  </view>
</view>
