@import '../tool.wxss';

.chip-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.chip {
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #555;
  background: #f7f8fa;
  border: 1rpx solid #eef0f3;
}

.chip.active {
  background: rgba(233, 69, 96, 0.1);
  color: #e94560;
  border-color: rgba(233, 69, 96, 0.35);
  font-weight: 600;
}

.match-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.match-item:last-child { border-bottom: none; }
.match-title { font-size: 28rpx; font-weight: 600; color: #1a1a2e; }
.match-meta { font-size: 24rpx; color: #999; margin: 6rpx 0; }
.match-symptoms {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
