.search-input-wrap {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 8rpx 8rpx 8rpx 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 64rpx;
}

.search-btn {
  background: #0f3460;
  color: #fff;
  font-size: 26rpx;
  padding: 16rpx 32rpx;
  border-radius: 32rpx;
}

.result-count {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.fault-item {
  padding: 28rpx;
}

.fault-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.fault-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  flex: 1;
}

.danger-badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.05);
  flex-shrink: 0;
  margin-left: 16rpx;
}

.fault-category {
  font-size: 22rpx;
  color: #0f3460;
  margin-bottom: 8rpx;
}

.fault-symptoms {
  font-size: 26rpx;
  color: #666;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
