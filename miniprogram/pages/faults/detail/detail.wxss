.detail-header {
  margin-bottom: 24rpx;
}

.header-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.header-main {
  flex: 1;
  min-width: 0;
}

.fav-btn {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #888;
  padding: 10rpx 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 999rpx;
  white-space: nowrap;
}

.fav-btn.active {
  color: #e94560;
  border-color: rgba(233, 69, 96, 0.4);
  background: rgba(233, 69, 96, 0.08);
}

.fault-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 16rpx;
}

.header-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.detail-category {
  font-size: 22rpx;
  color: #0f3460;
  background: rgba(15, 52, 96, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.danger-badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.05);
}

.section-content {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
}

.list-item {
  display: flex;
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
  margin-bottom: 8rpx;
}

.list-dot {
  margin-right: 12rpx;
  color: #0f3460;
}

.list-num {
  margin-right: 12rpx;
  color: #0f3460;
  font-weight: 600;
  min-width: 36rpx;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 24rpx;
  color: #0f3460;
  background: rgba(15, 52, 96, 0.08);
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
}

.tag.clickable {
  border: 1rpx solid rgba(15, 52, 96, 0.15);
}
