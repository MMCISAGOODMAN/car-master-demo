.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 20rpx 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.search-icon {
  margin-right: 16rpx;
  font-size: 28rpx;
}

.search-placeholder {
  color: #bbb;
  font-size: 28rpx;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.category-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.category-item:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.category-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.category-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
}
