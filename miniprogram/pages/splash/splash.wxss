.splash {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  opacity: 1;
  transition: opacity 0.4s ease;
}

.splash.fade-out {
  opacity: 0;
}

.splash-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0;
  transform: translateY(24rpx);
  transition: opacity 0.6s ease, transform 0.6s ease;
}

.splash-inner.show {
  opacity: 1;
  transform: translateY(0);
}

.logo-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
}

.logo-ring {
  position: absolute;
  inset: 0;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #fff5f7 0%, #eef4ff 100%);
  border: 2rpx solid #eef0f3;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.08);
}

.logo-icon {
  position: relative;
  font-size: 72rpx;
  line-height: 1;
}

.app-name {
  font-size: 56rpx;
  font-weight: 700;
  color: #1a1a2e;
  letter-spacing: 8rpx;
  margin-bottom: 16rpx;
}

.app-slogan {
  font-size: 26rpx;
  color: #999;
  letter-spacing: 4rpx;
  margin-bottom: 64rpx;
}

.loading {
  display: flex;
  gap: 12rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #e94560;
  animation: bounce 1.2s ease-in-out infinite;
}

.dot:nth-child(2) {
  animation-delay: 0.15s;
  background: #c62a47;
}

.dot:nth-child(3) {
  animation-delay: 0.3s;
  background: #0f3460;
}

@keyframes bounce {
  0%, 80%, 100% {
    transform: scale(0.6);
    opacity: 0.4;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}
